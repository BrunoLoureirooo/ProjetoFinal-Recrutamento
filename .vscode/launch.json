{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Server",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceRoot}/Server/PRH.Server.API/bin/Debug/net8.0/PRH.Server.API.dll",     
            "cwd": "${workspaceFolder}/Server/PRH.Server.API",
            "stopAtEntry": false    
        },
        {
            "name": "Client",
            "type": "blazorwasm",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceRoot}/Client/PRH.Client.Wasm/bin/Debug/net8.0/PRH.Client.Wasm.dll",
            "cwd": "${workspaceFolder}/Client/PRH.Client.Wasm",
            "browser": "chrome"
        }
    ],
    "compounds": [
        {
            "name": "Server/Client",
            "configurations": ["Server", "Client"]
        }
    ]
}