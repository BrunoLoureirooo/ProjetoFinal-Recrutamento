@using Microsoft.AspNetCore.Components.Authorization
@using PRH.Mobile.Pages.Auth
@using PRH.Mobile.Components.Layout

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@GetLayout(routeData)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(ErrorLayout)">
                <p role="alert">Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    private Type GetLayout(RouteData routeData)
    {
        var path = routeData.PageType?.FullName ?? "";
        Type layout = null;

        bool isAuthPage =
        path.Contains("Login", StringComparison.OrdinalIgnoreCase)
        ||
        path.Contains("ForgotPassword", StringComparison.OrdinalIgnoreCase);

        return isAuthPage ? typeof(AuthLayout) : typeof(MainLayout);
    }
}