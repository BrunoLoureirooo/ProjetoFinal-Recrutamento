@page "/recrutamentos/novo"
@using System.Collections.ObjectModel
@using Microsoft.AspNetCore.Authorization
@using PRH.Shared.DataTransferObjets.Cargo

@inject IRecrutamentoService RecrutamentoService
@inject IEmpresaService EmpresaService
@inject ICargoService CargoService
@inject ILookupService LookupService
@inject IFormularioService FormularioService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject DialogService DialogService

@inherits Notifications

@attribute [Authorize]

@if (_modalidades is null ||
_empresas is null ||
_tipos is null ||
_cargos is null ||
_formularios is null)
{
    <LoadingEntity Entity="componentes para recrutamento" />
}
else
{
    <Header Title="Novo Recrutamento" />
    <div class="container mt-4">
        <Card>
            <div class="row g-3">
                @if (_isAdministrador)
                {
                    <div class="col-12 col-md-6">
                        <RadzenDropDown class="w-100"
                        Placeholder="Empresa..."
                        @bind-Value=@_empresaRecrutamento
                        Data=@_empresas
                        TextProperty="@nameof(EmpresaDto.Nome)" />
                    </div>
                    <div class="col-12 col-md-6">
                        <RadzenTextBox @bind-Value="_nome" class="w-100" Placeholder="Nome..." />
                    </div>
                }
                else
                {
                    <div class="col-12">
                        <RadzenTextBox @bind-Value="_nome" class="w-100" Placeholder="Nome..." />
                    </div>
                }
                <div class="col-12">
                    <p class="fw-bold">Vagas:</p>
                    <ListAllGrid TItem="VagaCreateDisplayDto"
                    Entities="@_vagasRecrutamentoDisplay"
                    PageSize="5"
                    EntityName="vagas">
                        <RowTemplate Context="vaga">
                            <EntityCard>
                                <Content>
                                    <h5 class="mb-1 text-dark">
                                        @vaga.NumVagas vagas para @vaga.Cargo?.Nome @vaga.TipoVaga?.Descricao
                                    </h5>
                                    <p class="mb-0 text-muted small">@vaga.Modalidade?.Descricao</p>
                                    <div class="d-flex align-items-center gap-2">
                                        <p class="mb-0 text-muted small">Disponivel:</p>
                                        @if (vaga.CandidaturaDisponivel)
                                        {
                                            <RadzenIcon Icon="check_circle" IconColor="@Colors.Success" />
                                        }
                                        else
                                        {
                                            <RadzenIcon Icon="cancel" IconColor="@Colors.Danger" />
                                        }
                                    </div>
                                    <p class="mb-0 text-muted small">@vaga.Descricao</p>
                                </Content>
                            </EntityCard>
                        </RowTemplate>
                    </ListAllGrid>
                </div>
                @if (_isCreatingVaga)
                {
                    <Card Class="col-12">
                        <h3 class="mb-4">Criar Nova Vaga</h3>

                        <EditForm Model="@_novaVagaDisplay" OnValidSubmit="@SaveVaga">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="row g-3">
                                <div class="mb-3">
                                    <RadzenTextBox class="w-100" @bind-Value="_novaVagaDisplay.Descricao" Placeholder="Descrição..." />
                                </div>
                                <div class="col-12 col-md-4">
                                    <RadzenDropDown class="w-100"
                                    Data="@_modalidades"
                                    @bind-Value="_novaVagaDisplay.Modalidade"
                                    TextProperty="Descricao"
                                    Placeholder="Modalidade..." />
                                </div>
                                <div class="col-12 col-md-4">
                                    <RadzenDropDown class="w-100"
                                    Data="@_tipos"
                                    @bind-Value="_novaVagaDisplay.TipoVaga"
                                    TextProperty="Descricao"
                                    Placeholder="Tipo..." />
                                </div>
                                <div class="col-12 col-md-4">
                                    <RadzenDropDown Placeholder="Cargo..."
                                    class="w-100"
                                    @bind-Value="_novaVagaDisplay.Cargo"
                                    Data=@_cargos
                                    TextProperty="@nameof(CargoGetAllDto.Nome)" />
                                </div>
                                <div class="col-6">
                                    <label for="numVagas" class="w-100">Número de vagas</label>
                                    <RadzenNumeric id="numVagas" @bind-Value="_novaVagaDisplay.NumVagas" Min="1" class="w-100" />
                                </div>
                                <div class="col-6 d-flex align-items-center">
                                    <RadzenCheckBox id="candidaturaDisponivelVaga" class="me-2" @bind-Value="_novaVagaDisplay.CandidaturaDisponivel" />
                                    <label for="candidaturaDisponivelVaga" class="mb-0">Candidatura Disponível</label>
                                </div>
                                <div class="col-12">
                                    <label class="w-100 fw-bold">Formulários</label>
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <RadzenDropDown class="w-100 w-50"
                                        Placeholder="Selecione um formulário..."
                                        @bind-Value=@_formularioVaga
                                        Data=@_formularios
                                        TextProperty="@nameof(FormularioGetAllDto.Nome)" />
                                        <RadzenButton Icon="add" Class="btn btn-success" Click="@AddFormulario" />
                                    </div>

                                    <ListAllGrid TItem="FormularioGetAllDto"
                                    Entities="@_formulariosVaga"
                                    PageSize="5"
                                    EntityName="formularios">
                                        <RowTemplate Context="formulario">
                                            <EntityCard>
                                                <Content>
                                                    <h5 class="mb-1 text-dark">
                                                        @formulario.Nome
                                                    </h5>
                                                    <p class="mb-0 text-muted small">(@formulario.NomeUnico)</p>
                                                    <p class="mb-0 text-muted small">@formulario.TipoFormulario?.Descricao</p>
                                                </Content>
                                                <Buttons>
                                                    <RadzenButton Icon="visibility" Tooltip="Visualizar formulário"
                                                    Click="@(args => ShowFormularioPreview(formulario.Id))"
                                                    Class="btn btn-outline-primary" />
                                                    <RadzenButton Icon="delete" Tooltip="Remover formulario"
                                                    Click="@(args => RemoveFormulario(formulario))"
                                                    Class="btn btn-primary" />
                                                </Buttons>
                                            </EntityCard>
                                        </RowTemplate>
                                    </ListAllGrid>
                                </div>
                                <div class="col-lg-3"></div>
                                <div class="col-6 col-lg-3">
                                    <RadzenButton Icon="save" Class="btn btn-primary w-100" Type="submit" Text="Salvar" />
                                </div>
                                <div class="col-6 col-lg-3">
                                    <RadzenButton Icon="cancel" Class="btn btn-primary w-100" Click="@CancelVagaCreation" Text="Cancelar" />
                                </div>
                                <div class="col-lg-3"></div>
                            </div>
                        </EditForm>
                    </Card>
                    <div class="col-md-3"></div>
                    <div class="col-12 col-md-6">
                        <RadzenButton Icon="save" Text="Salvar recrutamento" Class="btn btn-primary w-100" Click="@SaveRecrutamento" />
                    </div>
                    <div class="col-md-3"></div>
                }
                else
                {
                    <div class="col-lg-3"></div>
                    <div class="col-6 col-lg-3">
                        <RadzenButton Icon="add" Class="btn btn-primary w-100" Click="@NewVaga" Text="Adicionar Vaga" />
                    </div>
                    <div class="col-6 col-lg-3">
                        <RadzenButton Icon="save" Text="Salvar recrutamento" Class="btn btn-primary w-100" Click="@SaveRecrutamento" />
                    </div>
                    <div class="col-lg-3"></div> 
                }

            </div>
        </Card>

    </div>
}


@code {
    private bool _isAdministrador;
    private bool _isCreatingVaga = false;

    // Lookups
    private IEnumerable<EmpresaDto> _empresas;
    private IEnumerable<LookupDto> _modalidades;
    private IEnumerable<LookupDto> _tipos;
    private IEnumerable<CargoGetAllDto> _cargos;
    private IEnumerable<FormularioGetAllDto> _formularios;

    // Vaga parts

    private IEnumerable<FormularioGetAllDto> _formulariosVaga = new List<FormularioGetAllDto>();
    private FormularioGetAllDto _formularioVaga;
    private VagaCreateDisplayDto _novaVagaDisplay;

    // Recrutamento parts
    private EmpresaDto _empresaRecrutamento;
    private string _nome = "";
    private IEnumerable<VagaCreateDisplayDto> _vagasRecrutamentoDisplay = new List<VagaCreateDisplayDto>();
    private IEnumerable<VagaCreateRecrutamentoDto> _vagasRecrutamento = new List<VagaCreateRecrutamentoDto>();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdministrador = authState.User.IsInRole("Administrador");

        if (_isAdministrador)
            _empresas = await EmpresaService.GetEmpresasAsync();
        else
        {
            _empresas = new List<EmpresaDto>();
            _empresaRecrutamento = await EmpresaService.GetMyEmpresaAsync();
        }

        _modalidades = await LookupService.GetModalidadesAsync();
        _tipos = await LookupService.GetTiposVagaAsync();
        _cargos = await CargoService.GetCargosAsync();
        _formularios = await FormularioService.GetFormulariosAsync();
    }

    private void NewVaga()
    {
        IEnumerable<FormularioGetAllDto> formulariosVaga = new List<FormularioGetAllDto>();

        _novaVagaDisplay = new VagaCreateDisplayDto
        {
            CandidaturaDisponivel = false,
            NumVagas = 1,
            Descricao = ""
        };

        _isCreatingVaga = true;
    }

    private void AddFormulario()
    {
        if(_formularioVaga is null)
        {
            Failure("Erro de criação de vaga", "Não selecionou o formulário");
            return;
        }
        _formulariosVaga = _formulariosVaga.Append(_formularioVaga).ToList();
    }

    private void RemoveFormulario(FormularioGetAllDto f)
    {
        if (f is not null)
            _formulariosVaga = _formulariosVaga.Where(x => x != f);
    }

    private void SaveVaga()
    {
        if (!_formulariosVaga.Any() || _formulariosVaga is null)
        {
            Failure("Erro de criação de vaga", "Vaga precisa de pelo menos um formulário");
            return;
        }

        VagaCreateRecrutamentoDto realVaga = new VagaCreateRecrutamentoDto
        {
            CandidaturaDisponivel = _novaVagaDisplay.CandidaturaDisponivel,
            NumVagas = _novaVagaDisplay.NumVagas,
            Descricao = _novaVagaDisplay.Descricao,
            ModalidadeId = _novaVagaDisplay.Modalidade.Id,
            CargoId = _novaVagaDisplay.Cargo.Id,
            TipoVagaId = _novaVagaDisplay.TipoVaga.Id,
            FormularioIds = new Collection<Guid>()
        };

        foreach(var form in _formulariosVaga)
        {
            realVaga.FormularioIds.Add(form.Id);
        }

        _vagasRecrutamentoDisplay = _vagasRecrutamentoDisplay.Append(_novaVagaDisplay).ToList();
        _vagasRecrutamento = _vagasRecrutamento.Append(realVaga).ToList();
        _isCreatingVaga = false;
        _formulariosVaga = new List<FormularioGetAllDto>();
        _formularioVaga = null;
    }

    public async Task SaveRecrutamento()
    {
        RecrutamentoCreateDto r = new RecrutamentoCreateDto();

        if(string.IsNullOrEmpty(_nome))
        {
            Failure("Erro de criação de recrutamento", "Recrutamento precisa de um nome");
            return;
        }

        r.Nome = _nome;

        if(_empresaRecrutamento is null)
        {
            Failure("Erro de criação de recrutamento", "Recrutamento precisa de pertencer a uma empresa");
            return;
        }

        r.EmpresaId = (_empresaRecrutamento).Id;

        if(_vagasRecrutamento is null || !_vagasRecrutamento.Any())
        {
            Failure("Erro de criação de recrutamento", "Recrutamento precisa de pelo menos uma vaga");
            return;
        }

        r.Vagas = new Collection<VagaCreateRecrutamentoDto>();
        foreach (var vaga in _vagasRecrutamento)
            r.Vagas.Add(vaga);

        var result = await RecrutamentoService.CreateRecrutamentoAsync(r);

        if(!result.IsSuccessStatusCode)
        {
            Failure("Erro de criação de recrutamento", "Algo correu mal na criação do recrutamento...");
            NavigationManager.NavigateTo("recrutamentos");
        }
        else
        {
            Success("Novo recrutamento criado", "O novo recrutamento para foi criado com sucesso!");
            RecrutamentoAfterCreateDto newRecrutamento = await result.Content.ReadFromJsonAsync<RecrutamentoAfterCreateDto>();
            NavigationManager.NavigateTo($"recrutamento/{newRecrutamento.Id}");
        }
    }

    private void CancelVagaCreation()
    {
        _isCreatingVaga = false;
        _novaVagaDisplay = null;
        _formulariosVaga = new List<FormularioGetAllDto>();
        _formularioVaga = null;
    }

    private async void ShowFormularioPreview(Guid id)
    {
        FormularioGetOneDto formulario = await FormularioService.GetFormularioByIdAsync(id);

        DialogService.Open<FormularioPreviewDialog>(
            "Preview do " + formulario.Nome,
            new Dictionary<string, object> {
                { "Campos", formulario.FormularioCampos }
                    },
            new DialogOptions
                {
                    Width = "50%",
                    Height = "50%",
                    CloseDialogOnOverlayClick = true
                });
    }
}
